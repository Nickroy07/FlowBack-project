# Flowback Backend - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# Required: Your AI provider API key
AI_API_KEY=your_api_key_here

# Optional: AI provider configuration
# Default: openai, supports any OpenAI-compatible API
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_URL=https://api.openai.com/v1/chat/completions

# Optional: Server port (default 3000)
PORT=3000

# Optional: For other providers, you can use:
# OpenAI: https://api.openai.com/v1/chat/completions (model: gpt-4o-mini, gpt-3.5-turbo, gpt-4o)
# Groq: https://api.groq.com/openai/v1/chat/completions (model: llama-3.1-8b-instant, mixtral-8x7b-32768)
# Together: https://api.together.xyz/v1/chat/completions
# OpenRouter: https://openrouter.ai/api/v1/chat/completions
# Local Ollama: http://localhost:11434/v1/chat/completions
